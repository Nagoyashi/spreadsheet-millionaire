# frontend/.env.example — copy to frontend/.env (local) or set in the Vercel
# project env. Every var is OPTIONAL: the app runs with none of them set.
# Anything VITE_-prefixed is baked into the public bundle — never put a secret here.
#
# Tracker/calculator visibility is NOT an env var — it's a runtime publish
# toggle in /admin (DECISIONS.md § "Runtime publish state").

# ── Product analytics (PostHog browser ingest) ────────────────────────────────
# The PUBLIC project key (phc_…). Unset disables PostHog in the browser.
VITE_POSTHOG_KEY=
# Ingest host (EU by default).
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ── Error monitoring (Sentry browser SDK) ─────────────────────────────────────
# Unset disables Sentry in the browser. Use an EU-region DSN.
VITE_SENTRY_DSN=
# Defaults: environment → Vite MODE; release → unset; tracesSampleRate → 0.
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
