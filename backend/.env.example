# backend/.env.example — copy to backend/.env and fill in. Never commit backend/.env.
#
# Which vars are REQUIRED vs optional is decided by config.py (the fail-fast
# checks at import time) — the comments below mirror it. Full dev/prod table:
# README.md § "Environment variables".

# ── Required (app exits at startup if missing/invalid) ────────────────────────
# Session-signing secret. Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Must be ≥32 chars and not the placeholder below.
FLASK_SECRET_KEY=replace-this-with-output-of-secrets-token-hex-32

# Neon Postgres — the POOLED (PgBouncer) connection string. Must start with
# "postgres"; sslmode=require is appended automatically if absent. No SQLite fallback.
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb

# ── Environment ───────────────────────────────────────────────────────────────
# development | production. Production makes REDIS_URL mandatory and switches
# log output to JSON.
FLASK_ENV=development

# Comma-separated allowed browser origins. Never a wildcard.
CORS_ORIGINS=http://localhost:5173

# Public frontend origin — used to build password-reset links. Set to the real
# frontend domain in production (a localhost value there only warns).
APP_BASE_URL=http://localhost:5173

# True in production (HTTPS only); False for local HTTP dev.
SESSION_COOKIE_SECURE=False

# ── Redis (Upstash) — sessions + rate limiting ────────────────────────────────
# REQUIRED when FLASK_ENV=production (app exits without it). Optional in dev:
# unset falls back to filesystem sessions + in-memory rate limiting.
REDIS_URL=

# ── Transactional email (Resend) — optional ───────────────────────────────────
# Unset disables email with a startup warning (welcome/reset emails skipped).
RESEND_API_KEY=
MAIL_FROM=noreply@example.com

# ── Error monitoring (Sentry) — optional ──────────────────────────────────────
# Unset disables Sentry entirely. Use an EU-region DSN (privacy invariant).
SENTRY_DSN=
# Fraction of requests carrying a performance trace (0 disables tracing).
SENTRY_TRACES_SAMPLE_RATE=0.1
# Defaults to FLASK_ENV / unset respectively.
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# ── Product analytics read-back (PostHog Query API — admin portal) — optional ─
# A PERSONAL API key with read scope (a secret — never VITE_-prefixed). Both key
# and project id are needed for the admin funnel card; unset shows its empty state.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
# API host (the app host, not the ingest host). EU by default.
POSTHOG_HOST=https://eu.posthog.com

# ── GA4 Data API (admin Analytics tab) — optional ─────────────────────────────
# Service-account credentials: raw JSON or a path to the key file.
GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=

# ── Logging — optional ────────────────────────────────────────────────────────
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR. LOG_FORMAT: json | plain
# (defaults to json in production, plain in development).
LOG_LEVEL=INFO
LOG_FORMAT=
